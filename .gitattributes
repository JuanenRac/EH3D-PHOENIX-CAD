# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# The project files are text with a byte count in front of each domain: no line-end conversion.
*.phoenixproj -text

# the sketch files are text with their own line ends: no conversion
*.phoenixsketch -text

# the library files are text with their own line ends: no conversion
*.phoenixlib -text
