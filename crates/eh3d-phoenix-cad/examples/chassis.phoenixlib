# A small library of generic parts for a chassis. The parts are made up for this example.
# Lengths are whole nanometres: 20000000 is 20 mm.
#
# part NAME profile MATERIAL WIDTH HEIGHT WALL USUAL_CUT LONGEST_CUT          (a wall of 0 is a solid bar)
# part NAME screw MATERIAL METRIC DIAMETER LENGTH HEAD HEAD_DIAMETER HEAD_HEIGHT   (HEAD: cylinder, countersunk or hex)
# part NAME bracket MATERIAL LEG_A LEG_B WIDTH THICKNESS HOLE_DIAMETER         (a hole of 0 is no hole)
phoenix-library 1
name chassis-basic
part tube-20x20 profile aluminium 20000000 20000000 1500000 300000000 2000000000
part tube-40x20 profile aluminium 40000000 20000000 2000000 300000000 2000000000
part bar-10x10 profile aluminium 10000000 10000000 0 100000000 1000000000
part bolt-m3x10 screw steel M3 3000000 10000000 cylinder 5500000 3000000
part flat-m3x8 screw steel M3 3000000 8000000 countersunk 6000000 1700000
part hex-m4x16 screw stainless M4 4000000 16000000 hex 7000000 2800000
part angle-30 bracket aluminium 30000000 30000000 20000000 3000000 4500000
part angle-20 bracket aluminium 20000000 20000000 16000000 2500000 3400000
