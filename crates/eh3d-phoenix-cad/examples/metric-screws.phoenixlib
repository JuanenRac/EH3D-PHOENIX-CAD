# A library of metric screws of the usual sizes and lengths: socket head cap screws (ISO 4762,
# a cylinder head) from M3 to M8 and hexagon head screws (ISO 4017) from M4 to M8. The sizes are
# the nominal ones of the standards; a screw has no thread drawn and its shank is the full diameter.
# Lengths are whole nanometres: 10000000 is 10 mm.
#
# part NAME screw MATERIAL METRIC DIAMETER LENGTH HEAD HEAD_DIAMETER HEAD_HEIGHT
phoenix-library 1
name metric-screws
part iso4762-m3x6 screw steel M3 3000000 6000000 cylinder 5500000 3000000
part iso4762-m3x8 screw steel M3 3000000 8000000 cylinder 5500000 3000000
part iso4762-m3x10 screw steel M3 3000000 10000000 cylinder 5500000 3000000
part iso4762-m3x12 screw steel M3 3000000 12000000 cylinder 5500000 3000000
part iso4762-m3x16 screw steel M3 3000000 16000000 cylinder 5500000 3000000
part iso4762-m3x20 screw steel M3 3000000 20000000 cylinder 5500000 3000000
part iso4762-m3x25 screw steel M3 3000000 25000000 cylinder 5500000 3000000
part iso4762-m3x30 screw steel M3 3000000 30000000 cylinder 5500000 3000000
part iso4762-m4x8 screw steel M4 4000000 8000000 cylinder 7000000 4000000
part iso4762-m4x10 screw steel M4 4000000 10000000 cylinder 7000000 4000000
part iso4762-m4x12 screw steel M4 4000000 12000000 cylinder 7000000 4000000
part iso4762-m4x16 screw steel M4 4000000 16000000 cylinder 7000000 4000000
part iso4762-m4x20 screw steel M4 4000000 20000000 cylinder 7000000 4000000
