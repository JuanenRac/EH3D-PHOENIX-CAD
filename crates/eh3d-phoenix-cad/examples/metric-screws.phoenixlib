part iso4762-m5x25 screw steel M5 5000000 25000000 cylinder 8500000 5000000
part iso4762-m5x30 screw steel M5 5000000 30000000 cylinder 8500000 5000000
part iso4762-m5x40 screw steel M5 5000000 40000000 cylinder 8500000 5000000
part iso4762-m6x10 screw steel M6 6000000 10000000 cylinder 10000000 6000000
part iso4762-m6x12 screw steel M6 6000000 12000000 cylinder 10000000 6000000
part iso4762-m6x16 screw steel M6 6000000 16000000 cylinder 10000000 6000000
part iso4762-m6x20 screw steel M6 6000000 20000000 cylinder 10000000 6000000
part iso4762-m6x25 screw steel M6 6000000 25000000 cylinder 10000000 6000000
part iso4762-m6x30 screw steel M6 6000000 30000000 cylinder 10000000 6000000
part iso4762-m6x40 screw steel M6 6000000 40000000 cylinder 10000000 6000000
part iso4762-m8x16 screw steel M8 8000000 16000000 cylinder 13000000 8000000
part iso4762-m8x20 screw steel M8 8000000 20000000 cylinder 13000000 8000000
part iso4762-m8x25 screw steel M8 8000000 25000000 cylinder 13000000 8000000
part iso4762-m8x30 screw steel M8 8000000 30000000 cylinder 13000000 8000000
part iso4762-m8x40 screw steel M8 8000000 40000000 cylinder 13000000 8000000
part iso4017-m4x10 screw stainless M4 4000000 10000000 hex 7000000 2800000
part iso4017-m4x16 screw stainless M4 4000000 16000000 hex 7000000 2800000
part iso4017-m4x20 screw stainless M4 4000000 20000000 hex 7000000 2800000
part iso4017-m4x25 screw stainless M4 4000000 25000000 hex 7000000 2800000
part iso4017-m4x30 screw stainless M4 4000000 30000000 hex 7000000 2800000
part iso4017-m5x10 screw stainless M5 5000000 10000000 hex 8000000 3500000
